{
  "name": "cpu-flow-trace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node --import tsx scripts/static-routes.mjs",
    "preview": "vite preview",
    "test": "node scripts/test.mjs",
    "test:workbench": "node --test workbench/*.test.cjs workbench/td4/*.test.cjs workbench/td4_v2/*.test.cjs && npm run test:td4-wide",
    "test:e2e": "playwright test",
    "test:e2e:dev": "PLAYWRIGHT_DEV=1 playwright test tests/e2e/cpu.spec.ts",
    "generate:td4-details": "node scripts/td4-details.mjs",
    "watch:td4-details": "node scripts/td4-details.mjs --watch",
    "check:td4-details": "node scripts/td4-details.mjs --check",
    "pretest:workbench": "npm run generate:td4-details",
    "test:td4-wide": "TD4_DETAIL_EDITION=wide node --test workbench/td4_v2/details.test.cjs",
    "test:ft16": "node --import tsx --test src/ft16/tests/*.test.js src/ft16/*.test.js src/pages/ft16/*.test.ts",
    "test:ft8": "node --test workbench/ft8/tests/*.test.js",
    "generate:cpu": "node scripts/generate-cpu-circuits.mjs",
    "check:cpu": "node scripts/generate-cpu-circuits.mjs --check"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "vite": "^7.1.5"
  }
}
